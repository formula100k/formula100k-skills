# Copia este archivo como .env y llena tus datos. El .env NUNCA se sube a GitHub.

# ---- Meta: WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → API Setup) ----
# Una palabra secreta que inventas tú y pegas también en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret: Configuración de la app → Básica → Clave secreta de la app.
WHATSAPP_APP_SECRET=
# Token de acceso (el temporal de API Setup sirve para probar; después usa uno permanente de usuario del sistema).
WHATSAPP_TOKEN=
# Phone number ID (el identificador del número, NO el número de teléfono).
WHATSAPP_PHONE_NUMBER_ID=
# Versión de la API que muestra Meta en los ejemplos de API Setup.
GRAPH_API_VERSION=v23.0

# ---- Modelo de IA: OpenRouter (openrouter.ai → Keys) ----
OPENROUTER_API_KEY=
# Elige en openrouter.ai/models uno que soporte "tools".
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ---- Agenda: Cal.com (Settings → Developer → API Keys) ----
CAL_API_KEY=
# El número del tipo de evento (lo ves en la dirección cuando editas el evento).
CAL_EVENT_TYPE_ID=

# ---- Tu negocio ----
ZONA_HORARIA=America/Mexico_City
# Tu número con código de país, sin + ni espacios (para avisarte cuando una clienta pide una persona).
TELEFONO_DUENA=
# Horas que el agente se queda callado con una clienta que pidió hablar con una persona.
PAUSA_HORAS=12

# ---- Memoria en producción (opcional en tu compu): Upstash Redis → REST API ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cuántos mensajes recientes recuerda de cada clienta.
MEMORIA_MENSAJES=20
